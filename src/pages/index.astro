---
import { currentWeek, listRoster, listWeeks } from "../lib/db";
import { DAYS, buildWeekGrid } from "../lib/schedule";
import "../styles.css";

const roster = listRoster();
const weeks = listWeeks();
const q = Astro.url.searchParams;

const intParam = (key: string): number | null => {
  const v = q.get(key);
  return v && /^\d+$/.test(v) ? Number(v) : null;
};

const requestedWeek = intParam("week");
const weekNum = weeks.some((w) => w.week === requestedWeek) ? (requestedWeek as number) : currentWeek();
const week = weeks.find((w) => w.week === weekNum)!;
const nowWeek = currentWeek();
const grid = buildWeekGrid(roster, weekNum, week.monday);

const selectedId = intParam("group");
const changedId = intParam("changed");
const mineParam = q.get("mine");
const mine = mineParam && roster.some((g) => g.agent === mineParam) ? mineParam : null;
const flash = q.get("flash");
const error = q.get("error");

const link = (params: Record<string, string | number | null> = {}) => {
  const sp = new URLSearchParams();
  for (const [k, v] of Object.entries({ week: weekNum, mine, ...params })) {
    if (v !== null) sp.set(k, String(v));
  }
  return `/?${sp}`;
};

const sessions = grid.days.flatMap((d) => d.sessions);
const selected = sessions.find((s) => s.groupId === selectedId) ?? null;
const changed = sessions.find((s) => s.groupId === changedId) ?? null;
const movedSessions = sessions.filter((s) => s.exceptionId !== null);
const weeksWithChanges = new Set(roster.flatMap((g) => g.sessions.filter((s) => s.exceptionId !== null).map((s) => s.week)));

const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-AU", { day: "numeric", month: "short", timeZone: "UTC" });
const dateOf = (day: string) => grid.days.find((d) => d.day === day)?.date ?? week.monday;

const draft = (key: string, fallback = "") => q.get(key) ?? fallback;
const REASONS = ["Public holiday", "Tutor unavailable", "Room unavailable", "Clash with another class", "Student request"];
const prevWeek = weeks.find((w) => w.week === weekNum - 1);
const nextWeek = weeks.find((w) => w.week === weekNum + 1);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="This course's crit-group timetable: a week-by-week grid of every group's session. Click a session to reschedule it; changes are saved to SQLite and synced across tabs."
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Crit timetable</title>
  </head>
  <body>
    <nav aria-label="site" class="site-nav">
      <strong class="brand">Crit timetable</strong>
      <a href="/">Timetable</a>
      <a href="/readme/">About</a>
    </nav>
    <main class="wide">
      <h1>Week {weekNum} <span class="h1-sub">{fmtDate(week.monday)} – {fmtDate(dateOf("Fri"))}</span></h1>

      <p id="stale-notice" class="banner" role="status" hidden>
        The timetable changed in another tab. <a href={link()}>Refresh to see it</a>
      </p>

      <div class="toolbar">
        <nav aria-label="teaching weeks" class="week-strip">
          {prevWeek && <a class="step" href={link({ week: prevWeek.week })} rel="prev">← Week {prevWeek.week}</a>}
          <ol>
            {
              weeks.map((w) => (
                <li>
                  <a
                    href={link({ week: w.week })}
                    aria-current={w.week === weekNum ? "page" : undefined}
                    class:list={[{ now: w.week === nowWeek, edited: weeksWithChanges.has(w.week) }]}
                  >
                    <span class="sr">Week </span>{w.week}
                    {w.week === nowWeek && <span class="sr"> (this week)</span>}
                    {weeksWithChanges.has(w.week) && <span class="sr"> (has changes)</span>}
                  </a>
                </li>
              ))
            }
          </ol>
          {nextWeek && <a class="step" href={link({ week: nextWeek.week })} rel="next">Week {nextWeek.week} →</a>}
        </nav>

        <form method="get" action="/" class="filter">
          <input type="hidden" name="week" value={weekNum} />
          <label for="mine">Highlight my group</label>
          <select id="mine" name="mine">
            <option value="">Everyone</option>
            {
              roster.map((g) => (
                <option value={g.agent} selected={g.agent === mine}>
                  {g.name}
                </option>
              ))
            }
          </select>
          <button type="submit" class="secondary">Apply</button>
        </form>
      </div>

      {
        flash && (
          <div id="flash" class="flash" role="status">
            {flash === "moved" && changed ? (
              <p>
                Moved <strong>{changed.name}</strong> to {changed.day} {fmtDate(dateOf(changed.day))}, {changed.startTime}–{changed.endTime}.
              </p>
            ) : flash === "reverted" && changed ? (
              <p>
                <strong>{changed.name}</strong> is back at its standing slot in week {weekNum}.
              </p>
            ) : (
              <p>Timetable updated.</p>
            )}
            {flash === "moved" && changed?.exceptionId && (
              <form method="post" action={`/api/exceptions/${changed.exceptionId}/cancel`}>
                <input type="hidden" name="week" value={weekNum} />
                <input type="hidden" name="group" value={changed.groupId} />
                <button type="submit" class="secondary">Undo</button>
              </form>
            )}
          </div>
        )
      }

      <div class="layout">
        <div class="grid-wrap">
          <div class="week-grid" style={`--hours:${grid.hours.length}`}>
            <div class="gutter" aria-hidden="true">
              <div class="day-head"></div>
              <div class="hour-labels">
                {grid.hours.map((h) => <span>{String(h).padStart(2, "0")}:00</span>)}
              </div>
            </div>
            {
              grid.days.map((d) => (
                <section class="day" aria-labelledby={`day-${d.day}`}>
                  <h2 class="day-head" id={`day-${d.day}`}>
                    {d.day} <span>{fmtDate(d.date)}</span>
                  </h2>
                  <ul class:list={["track", { "is-empty": d.sessions.length === 0 }]}>
                    {d.sessions.map((s) => (
                      <li
                        class:list={[
                          "block",
                          `tutor-${s.tutorIndex % 3}`,
                          {
                            moved: s.exceptionId !== null,
                            clash: s.clash,
                            dim: mine !== null && s.agent !== mine,
                            selected: s.groupId === selectedId,
                            "just-changed": flash !== null && s.groupId === changedId,
                          },
                        ]}
                        style={`--top:${s.top}%;--height:${s.height}%;--lane:${s.lane};--lanes:${s.lanes}`}
                      >
                        <a href={`${link({ group: s.groupId })}#reschedule`} aria-current={s.groupId === selectedId ? "true" : undefined}>
                          <span class="sr">Reschedule </span>
                          <strong>{s.name}</strong>
                          <span class="time">{s.startTime}–{s.endTime}</span>
                          <span class="who">{s.tutorName}</span>
                          {s.exceptionId !== null && <span class="tag">Moved</span>}
                          {s.clash && <span class="tag tag-clash">Clash</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>

          <section class="changes" aria-labelledby="changes-title">
            <h2 id="changes-title">Changes in week {weekNum}</h2>
            {
              movedSessions.length === 0 ? (
                <p class="muted">Every group meets at its standing slot this week.</p>
              ) : (
                <ul>
                  {movedSessions.map((s) => (
                    <li>
                      <strong>{s.name}</strong>: {s.day} {s.startTime}–{s.endTime} · {s.room} — {s.reason}
                      <span class="muted"> (standing: {s.standing.day} {s.standing.startTime}–{s.standing.endTime})</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </section>
        </div>

        <aside id="reschedule" class="panel" aria-labelledby="panel-title">
          <h2 id="panel-title">{selected ? `Reschedule ${selected.name}` : "Reschedule a session"}</h2>
          {
            selected ? (
              <p class="muted">
                Week {weekNum}: currently {selected.day} {selected.startTime}–{selected.endTime}, {selected.room}.
                {selected.exceptionId !== null && <> Moved from its standing slot — {selected.reason}.</>}
              </p>
            ) : (
              <p class="muted">Pick a session on the grid, or choose a group below.</p>
            )
          }

          {error && <p class="error" role="alert">{error}</p>}

          <form method="post" action="/api/exceptions" class="stack">
            <label for="critGroupId">Crit group</label>
            <select id="critGroupId" name="critGroupId" required>
              {
                roster.map((g) => (
                  <option value={g.id} selected={g.id === selectedId}>
                    {g.name} ({g.day} {g.startTime}–{g.endTime})
                  </option>
                ))
              }
            </select>

            <label for="week">Teaching week</label>
            <select id="week" name="week" required>
              {
                weeks.map((w) => (
                  <option value={w.week} selected={w.week === weekNum}>
                    Week {w.week} ({w.monday})
                  </option>
                ))
              }
            </select>

            <div class="row">
              <div>
                <label for="day">New day</label>
                <select id="day" name="day" required>
                  {
                    DAYS.map((day) => (
                      <option value={day} selected={day === draft("day", selected?.day ?? "Mon")}>
                        {day}
                      </option>
                    ))
                  }
                </select>
              </div>
              <div>
                <label for="startTime">Start</label>
                <input id="startTime" name="startTime" type="time" required value={draft("startTime", selected?.startTime ?? "")} />
              </div>
              <div>
                <label for="endTime">End</label>
                <input id="endTime" name="endTime" type="time" required value={draft("endTime", selected?.endTime ?? "")} />
              </div>
            </div>

            <label for="room">Room</label>
            <input id="room" name="room" type="text" placeholder="defaults to the group's usual room" value={draft("room")} />

            <label for="reason">Reason</label>
            <input id="reason" name="reason" type="text" list="reasons" required value={draft("reason")} />
            <datalist id="reasons">
              {REASONS.map((r) => <option value={r} />)}
            </datalist>

            <button type="submit">Reschedule</button>
          </form>

          {
            selected?.exceptionId != null && (
              <form method="post" action={`/api/exceptions/${selected.exceptionId}/cancel`} class="undo">
                <input type="hidden" name="week" value={weekNum} />
                <input type="hidden" name="group" value={selected.groupId} />
                <button type="submit" class="secondary">Undo — back to standing slot</button>
              </form>
            )
          }
        </aside>
      </div>
    </main>
    <script>
      import { createReconnectGate } from "../lib/live-reload";

      // Other tabs learn about a change over the SSE stream. Reloading would
      // wipe a half-typed reschedule, so just say so and let the user choose.
      const banner = document.getElementById("stale-notice");
      const showBanner = () => banner?.removeAttribute("hidden");
      const source = new EventSource("/api/events");
      source.addEventListener("message", showBanner);
      const shouldNotifyOnOpen = createReconnectGate();
      source.addEventListener("open", () => {
        if (shouldNotifyOnOpen()) showBanner();
      });
    </script>
  </body>
</html>
